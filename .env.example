# Copy this file to ".env" and fill in your own values. Never commit ".env".
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local MySQL (MySQL Workbench / MySQL Server)
DB_NAME=db_employee
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Demo logins, created by `python manage.py create_admin`
# Admin (HR) -> admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# CEO -> CEO dashboard
CEO_USERNAME=ceo
CEO_PASSWORD=ceo123
CEO_EMAIL=ceo@example.com

# Employee -> employee dashboard
EMPLOYEE_USERNAME=john
EMPLOYEE_PASSWORD=emp123
EMPLOYEE_EMAIL=john@example.com
EMPLOYEE_NAME=John Doe